<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime: DSV tokenizer for the wide-CSV source (decisions.md D-041). -->
    <PackageVersion Include="Sep" Version="0.15.0" />
    <!-- Runtime: TOML parser for the Bedrock spec format, confined to
         FcaBedrock.Spec (decisions.md D-009/D-066). -->
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test-only. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.3" />
    <!-- Benchmark-only: the M8 harness host (decisions.md D-124). Pinned to an exact
         baseline version rather than a floating latest, because BenchmarkDotNet owns the
         measurement semantics every M8 comparison is stated in. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
