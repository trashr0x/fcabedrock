<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common test config inherited from tests/Directory.Build.props. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\FcaBedrock.Spec\FcaBedrock.Spec.csproj" />
    <!-- Test-only (production Spec does not, and must not, reference Sources): §10.2's
         duplicate-header binding rule is only meaningful over a schema read from real bytes,
         which is what Toml/HeaderBindingTests exercises. -->
    <ProjectReference Include="..\..\src\FcaBedrock.Sources\FcaBedrock.Sources.csproj" />
  </ItemGroup>

  <!-- The real mini-dates v2 .bed, copied next to the test assembly so the
       migrator conformance test reads the on-disk fixture (not a synthetic one),
       via AppContext.BaseDirectory. A plain copy; the migrator parses lines, so
       EOL normalization is irrelevant (no byte comparison). -->
  <ItemGroup>
    <Content Include="$(RepoRoot)fixtures\v2\mini-dates\mini-dates_triples.bed" Link="fixtures\v2\mini-dates\mini-dates_triples.bed" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
