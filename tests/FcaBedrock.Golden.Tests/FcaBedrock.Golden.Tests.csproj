<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Guard: fail the run (MTP exit code 9) if this project discovers 0 tests,
         so a broken test setup cannot silently green a CI run. -->
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 1</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- User-supplied v2 golden fixtures, copied next to the test assembly so tests
       read them via AppContext.BaseDirectory. A plain file copy preserves bytes;
       .gitattributes prevents EOL normalization. The README is excluded. When no
       fixtures are present the glob matches nothing and the harness skips. -->
  <ItemGroup>
    <Content Include="$(RepoRoot)fixtures\v2\**\*" Exclude="$(RepoRoot)fixtures\v2\**\*.md" Link="fixtures\v2\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
