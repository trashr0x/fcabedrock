<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common test config (IsTestProject, the zero-tests guard, xunit.v3, the
       Xunit global using) is inherited from tests/Directory.Build.props. -->

  <!-- The full pipeline under test: read .bed (Spec) -> source (Sources) ->
       plan (Core) -> emit (Conversion) -> write (Export), byte-compared to the
       v2 goldens. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FcaBedrock.Spec\FcaBedrock.Spec.csproj" />
    <ProjectReference Include="..\..\src\FcaBedrock.Sources\FcaBedrock.Sources.csproj" />
    <ProjectReference Include="..\..\src\FcaBedrock.Conversion\FcaBedrock.Conversion.csproj" />
    <ProjectReference Include="..\..\src\FcaBedrock.Export\FcaBedrock.Export.csproj" />
    <!-- Test-only: InternetAdsExitTests runs the real Discovery probe engine for the M6
         exit's probe -> curate -> convert journey (D-119). A test-project dependency only —
         no production package references Discovery, and Discovery still references neither
         Conversion nor Export (Discovery_ShouldOnlyDependOnSourcesSpecCoreAndDiagnostics). -->
    <ProjectReference Include="..\..\src\FcaBedrock.Discovery\FcaBedrock.Discovery.csproj" />
  </ItemGroup>

  <!-- User-supplied v2 golden fixtures, copied next to the test assembly so tests
       read them via AppContext.BaseDirectory. A plain file copy preserves bytes;
       .gitattributes prevents EOL normalization. The README is excluded. When no
       fixtures are present the glob matches nothing and the harness skips. -->
  <ItemGroup>
    <Content Include="$(RepoRoot)fixtures\v2\**\*" Exclude="$(RepoRoot)fixtures\v2\**\*.md" Link="fixtures\v2\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
