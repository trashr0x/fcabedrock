<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common test config (IsTestProject, the zero-tests guard, xunit.v3, the
       Xunit global using) is inherited from tests/Directory.Build.props. -->

  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
  </ItemGroup>

  <!-- Referenced only so their assemblies land in this project's output directory
       for reflection (a test seam, EP-6). The dependency-direction rules are
       asserted over the compiled FcaBedrock.*.dll metadata. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FcaBedrock.Diagnostics\FcaBedrock.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\FcaBedrock.Core\FcaBedrock.Core.csproj" />
    <ProjectReference Include="..\..\src\FcaBedrock.Sources\FcaBedrock.Sources.csproj" />
    <ProjectReference Include="..\..\src\FcaBedrock.Conversion\FcaBedrock.Conversion.csproj" />
    <ProjectReference Include="..\..\src\FcaBedrock.Export\FcaBedrock.Export.csproj" />
    <ProjectReference Include="..\..\src\FcaBedrock.Spec\FcaBedrock.Spec.csproj" />
    <ProjectReference Include="..\..\src\FcaBedrock.Discovery\FcaBedrock.Discovery.csproj" />
    <!-- Explicit, not left to the Cli reference's transitive copy: the Orchestration rules below
         must inspect the loaded assembly, and an assembly missing from this project's output
         would let them pass vacuously. -->
    <ProjectReference Include="..\..\src\FcaBedrock.Orchestration\FcaBedrock.Orchestration.csproj" />
    <!-- Test-only. No production package may reference Cli, so nothing else
         would ever place FcaBedrock.Cli.dll in this project's output, and without the
         assembly loaded, Cli_ShouldNotBeReferencedByAnyProductionPackage would pass
         vacuously, which is exactly the failure it exists to catch. -->
    <ProjectReference Include="..\..\src\FcaBedrock.Cli\FcaBedrock.Cli.csproj" />
  </ItemGroup>

</Project>
